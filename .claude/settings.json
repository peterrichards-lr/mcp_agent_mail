{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push upstream:*)",
      "Bash(gh repo delete:*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(git stash:*)",
      "Bash(git checkout --:*)",
      "Bash(git restore:*)",
      "Bash(git branch -D:*)",
      "Bash(git push origin --delete:*)",
      "Bash(gh release:*)"
    ]
  }
}
