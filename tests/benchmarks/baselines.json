{
  "$schema": "baselines-schema.json",
  "version": 2,
  "description": "Performance baselines for CI regression detection. Failing thresholds will cause CI to fail.",
  "calibration": {
    "measured": "2026-10-19, 15 CI runs on ubuntu-latest (39212944344 to 39258982047)",
    "rule": "p95/p99 (fail CI) = 2x the worst run, mean (warns) = 1.5x the worst run, rounded up to 10 ms. A limit is only tightened, except where it fired on normal runs. Each dataset is the one its benchmark runs, and the check fails if they differ (#28)."
  },
  "thresholds": {
    "latency_regression_percent": 15,
    "query_count_regression_percent": 20
  },
  "baselines": {
    "send_message": {
      "description": "Send a single message to one recipient",
      "dataset": {
        "message_size": 512,
        "recipients": 1
      },
      "latency_ms": {
        "p95_max": 500,
        "p99_max": 590,
        "mean_max": 360
      },
      "query_stats": {
        "avg_per_op_max": 5,
        "total_max_per_iteration": 5
      }
    },
    "fetch_inbox": {
      "description": "Fetch an inbox of 200 messages, 100 at a time",
      "dataset": {
        "limit": 100,
        "message_count": 200,
        "message_size": 256
      },
      "latency_ms": {
        "p95_max": 400,
        "p99_max": 400,
        "mean_max": 200
      },
      "query_stats": {
        "avg_per_op_max": 3,
        "total_max_per_iteration": 3
      }
    },
    "list_outbox": {
      "description": "List an outbox of 150 messages to 3 recipients (slow: a git lookup per message)",
      "dataset": {
        "message_count": 150,
        "message_size": 256,
        "recipients": 3
      },
      "latency_ms": {
        "p95_max": 5000,
        "p99_max": 6000,
        "mean_max": 4500
      },
      "query_stats": {
        "avg_per_op_max": 3,
        "total_max_per_iteration": 3
      }
    },
    "search_messages": {
      "description": "FTS search over 300 messages",
      "dataset": {
        "message_count": 300,
        "message_size": 256,
        "query": "alpha OR beta"
      },
      "latency_ms": {
        "p95_max": 140,
        "p99_max": 140,
        "mean_max": 100
      },
      "query_stats": {
        "avg_per_op_max": 3,
        "total_max_per_iteration": 3
      }
    },
    "summarize_thread": {
      "description": "Summarize a thread of 40 messages",
      "dataset": {
        "message_count": 40,
        "message_size": 256,
        "thread_id": "bench-thread-001"
      },
      "latency_ms": {
        "p95_max": 190,
        "p99_max": 190,
        "mean_max": 140
      },
      "query_stats": {
        "avg_per_op_max": 5,
        "total_max_per_iteration": 5
      }
    }
  }
}
